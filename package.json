{
  "name": "@anchovie/schematic",
  "version": "2.2.10",
  "description": "Write Shopify schema with JS, not JSON.",
  "keywords": [
    "shopify",
    "section",
    "schema",
    "build"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "schematic": "bin/schematic"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "pretest": "npm run build",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/fixtures/"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anchovie91471/schematic.git"
  },
  "author": "Anthony Baggett <anthony.baggett@gmail.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/anchovie91471/schematic/issues"
  },
  "homepage": "https://github.com/anchovie91471/schematic#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "jest": "^30.2.0"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "fs-extra": "^11.3.0",
    "ora": "^9.0.0"
  }
}
