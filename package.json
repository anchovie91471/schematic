{
  "name": "@anchovie/schematic",
  "version": "2.2.6",
  "description": "Write Shopify schema with JS, not JSON.",
  "keywords": [
    "shopify",
    "section",
    "schema",
    "build"
  ],
  "main": "./loader.js",
  "bin": {
    "schematic": "bin/schematic"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/fixtures/"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anchovie91471/schematic.git"
  },
  "author": "Anthony Baggett <anthony.baggett@gmail.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/anchovie91471/schematic/issues"
  },
  "homepage": "https://github.com/anchovie91471/schematic#readme",
  "devDependencies": {
    "jest": "^30.2.0"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "fs-extra": "^11.3.0",
    "ora": "^9.0.0"
  }
}
