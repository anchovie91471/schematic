#!/usr/bin/env node
const chalk = require('chalk');
const { Schematic } = require('../src/schematic.js');

// Simple flag parser
function parseFlags(args) {
  const flags = {};
  const positional = [];

  for (let i = 0; i < args.length; i++) {
    const arg = args[i];

    if (arg.startsWith('--')) {
      // Long flag: --short, --block
      const key = arg.slice(2);
      flags[key] = true;
    } else if (arg.startsWith('-') && arg.length === 2) {
      // Short flag: -s, -b
      const key = arg.slice(1);
      flags[key] = true;
    } else {
      positional.push(arg);
    }
  }

  return { flags, positional };
}

// Log an error message and exit non-zero. All CLI exits go through here so
// library code can stay exit-free.
function bail(msg) {
  console.error(msg);
  process.exit(1);
}

// Format a library-thrown error for display, then exit 1.
// Known error codes get friendlier formatting; everything else falls back
// to logger.error + raw message.
function displayErrorAndExit(app, err) {
  const tip = app.logger.useColor ? chalk.yellow('💡 Tip:') : 'Tip:';

  if (err.code === 'MISSING_DIRECTORIES') {
    app.logger.error('Missing required directories');
    console.log('   Missing:', err.missing.join(', '));
    console.log();
    console.log(tip, 'Run this command from your Shopify theme root directory');
    console.log('   Expected structure:');
    console.log('   - ./config/');
    console.log('   - ./sections/');
    console.log('   - ./snippets/');
    console.log('   - ./locales/');
    console.log('   - ./src/schema/');
  } else if (err.code === 'FILE_EXISTS') {
    app.logger.error(`File already exists: ${err.filename}`);
    console.log('  Please choose a different name or remove the existing file.');
  } else {
    app.logger.error(err.message);
  }

  process.exit(1);
}

// Main async entry point - properly awaits all async methods
(async () => {
  const app = new Schematic();
  app.envDefaults(); // looks at env vars to determine opts

  // Parse command line arguments
  const args = process.argv.slice(2);
  const { flags, positional } = parseFlags(args);
  const [ command, arg ] = positional;

  try {
    if (command) {
      if (command === 'scaffold') {
        if (!arg) bail('scaffold requires a filename [section-name]');

        const short = flags.short || flags.s || false;
        const blockOnly = flags.block || flags.b || false;

        // Validate flag combinations
        if (short && blockOnly) {
          app.logger.error('--short and --block flags cannot be used together');
          console.log('  --short applies to sections only');
          process.exit(1);
        }

        await app.scaffold(arg, short, blockOnly);
      }

      else if (command === 'section') {
        if (!arg) bail('section requires a file path');

        await app.runSection(arg);
      }

      else if (command === 'init') {
        const filename = arg || 'schematic';  // Default to 'schematic' if no name provided
        await app.init(filename);
      }

      else bail(`command not recognized: "${command}". Valid commands are: scaffold, section, init`);
    }

    else await app.run();
  } catch (err) {
    displayErrorAndExit(app, err);
  }
})();
