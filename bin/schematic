#!/usr/bin/env node
const { Schematic } = require('../src/schematic.js');

// Simple flag parser
function parseFlags(args) {
  const flags = {};
  const positional = [];

  for (let i = 0; i < args.length; i++) {
    const arg = args[i];

    if (arg.startsWith('--')) {
      // Long flag: --short, --block
      const key = arg.slice(2);
      flags[key] = true;
    } else if (arg.startsWith('-') && arg.length === 2) {
      // Short flag: -s, -b
      const key = arg.slice(1);
      flags[key] = true;
    } else {
      positional.push(arg);
    }
  }

  return { flags, positional };
}

const app = new Schematic();
app.envDefaults(); // looks at env vars to determine opts

// Parse command line arguments
const args = process.argv.slice(2);
const { flags, positional } = parseFlags(args);
const [ command, arg ] = positional;

if (command) {
  if (command === 'scaffold') {
    if (!arg) app.exit(`scaffold requires a filename [section-name]`);

    const short = flags.short || flags.s || false;
    const blockOnly = flags.block || flags.b || false;

    // Validate flag combinations
    if (short && blockOnly) {
      app.logger.error('--short and --block flags cannot be used together');
      console.log('  --short applies to sections only');
      process.exit(1);
    }

    app.scaffold(arg, short, blockOnly);
  }

  else if (command === 'section') {
    if (!arg) app.exit(`section requires a file path`);

    app.runSection(arg);
  }

  else if (command === 'init') {
    const filename = arg || 'schematic';  // Default to 'schematic' if no name provided
    app.init(filename);
  }

  else app.exit(`command not recognized`);
}

else app.run();
