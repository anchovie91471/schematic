#!/usr/bin/env node
const chalk = require('chalk');
const { readFileSync } = require('node:fs');
const path = require('node:path');
const { Schematic } = require('../dist/index.cjs');

const pkg = JSON.parse(
  readFileSync(path.resolve(__dirname, '..', 'package.json'), 'utf-8')
);

// Shared args attached to every subcommand. `--verbose` has no short alias
// because Citty reserves `-v` for `--version`. `--config` is accepted now
// but errors out until phase 6.2 ships config discovery, so the CLI surface
// stabilizes before the feature lands.
const sharedArgs = {
  verbose: {
    type: 'boolean',
    description: 'Detailed output with all file paths (equivalent to SCHEMATIC_VERBOSE=1)',
  },
  config: {
    type: 'string',
    description: 'Path to a config file, bypassing auto-discovery (e.g., --config=./schematic.dev.js)',
  },
};

// Load user config via c12 — auto-discovers schematic.config.{js,cjs,mjs},
// .schematicrc, and package.json#schematic field in cwd. If `--config <path>`
// is given, loads that file explicitly instead of searching.
// Returns { config, configFile } where configFile is the absolute path of
// whichever file was found (null if defaults only).
async function loadConfiguration(args) {
  const { loadConfig } = await import('c12');

  if (args.config) {
    // Explicit override — bypass discovery.
    const explicitPath = path.resolve(process.cwd(), args.config);
    const result = await loadConfig({
      cwd: process.cwd(),
      configFile: explicitPath,
      packageJson: false,
      rcFile: false,
      envName: process.env.NODE_ENV,
      omit$Keys: true,
    });
    if (!result.configFile) {
      throw new Error(`Config file not found: ${args.config}`);
    }
    return { config: result.config || {}, configFile: result.configFile };
  }

  // Auto-discovery mode.
  const result = await loadConfig({
    cwd: process.cwd(),
    name: 'schematic', // finds schematic.config.{js,cjs,mjs} + .schematicrc*
    packageJson: true, // also reads package.json#schematic
    envName: process.env.NODE_ENV, // merges $development/$production/$test blocks
    omit$Keys: true, // strip the $env keys from the final shape
  });

  return { config: result.config || {}, configFile: result.configFile || null };
}

async function createApp(args) {
  const { config, configFile } = await loadConfiguration(args);

  // Pass loaded config (possibly empty) to Schematic. Its constructor
  // deep-merges with built-in defaults for any key the user didn't set.
  const app = new Schematic(Object.keys(config).length ? config : undefined);
  app.envDefaults();
  if (args.verbose) app.logger.setVerbose(true);

  // Surface the loaded config path in verbose mode so users can see which
  // file won when multiple candidates exist.
  if (configFile && app.logger.verbose) {
    app.logger.info(`Loaded config: ${path.relative(process.cwd(), configFile) || configFile}`);
  }

  return app;
}

function displayErrorAndExit(app, err) {
  const tip = app.logger.useColor ? chalk.yellow('💡 Tip:') : 'Tip:';

  if (err.code === 'MISSING_DIRECTORIES') {
    app.logger.error('Missing required directories');
    console.log('   Missing:', err.missing.join(', '));
    console.log();
    console.log(tip, 'Run this command from your Shopify theme root directory');
    console.log('   Expected structure:');
    console.log('   - ./config/');
    console.log('   - ./sections/');
    console.log('   - ./snippets/');
    console.log('   - ./locales/');
    console.log('   - ./src/schema/');
  } else if (err.code === 'FILE_EXISTS') {
    app.logger.error(`File already exists: ${err.filename}`);
    console.log('  Please choose a different name or remove the existing file.');
  } else {
    app.logger.error(err.message);
  }

  process.exit(1);
}

// Every subcommand's run goes through this wrapper: shared app construction,
// shared error handling, guaranteed exit-1-on-error behavior.
function wrapRun(runFn) {
  return async ({ args }) => {
    let app;
    try {
      app = await createApp(args);
    } catch (err) {
      // createApp itself can throw (config file missing/malformed). We don't
      // have a fully-initialized Schematic yet, so surface a lightweight error.
      console.error(err.message);
      process.exit(1);
    }

    try {
      await runFn(app, args);
    } catch (err) {
      displayErrorAndExit(app, err);
    }
  };
}

// Citty is ESM-only; bin/schematic stays CJS for compatibility with the
// existing shebang path. Dynamic import at the top of the async IIFE
// bridges the gap without needing a .mjs file or type=module in package.json.
(async () => {
  const { defineCommand, runMain } = await import('citty');

  const buildRun = wrapRun(async (app) => {
    await app.run();
  });

  const buildCommand = defineCommand({
    meta: {
      name: 'build',
      description: 'Compile all schemas: sections, theme blocks, settings, locales',
    },
    args: { ...sharedArgs },
    run: buildRun,
  });

  const scaffoldCommand = defineCommand({
    meta: {
      name: 'scaffold',
      description: 'Create placeholder liquid + schema files for a new section or block',
    },
    args: {
      name: {
        type: 'positional',
        description: 'Section/block name (kebab-case recommended)',
        required: true,
      },
      short: {
        type: 'boolean',
        description: 'Use compact {% render %} syntax (writeCodeShort)',
        alias: 's',
      },
      block: {
        type: 'boolean',
        description: 'Scaffold a theme block (no section/snippet files)',
        alias: 'b',
      },
      ...sharedArgs,
    },
    run: wrapRun(async (app, args) => {
      if (args.short && args.block) {
        app.logger.error('--short and --block flags cannot be used together');
        console.log('  --short applies to sections only');
        process.exit(1);
      }
      await app.scaffold(args.name, args.short || false, args.block || false);
    }),
  });

  const sectionCommand = defineCommand({
    meta: {
      name: 'section',
      description: 'Rebuild a single section by file path',
    },
    args: {
      file: {
        type: 'positional',
        description: 'Section file path (absolute or relative to theme root)',
        required: true,
      },
      ...sharedArgs,
    },
    run: wrapRun(async (app, args) => {
      await app.runSection(args.file);
    }),
  });

  const initCommand = defineCommand({
    meta: {
      name: 'init',
      description: 'Generate a schematic.config.js (or an executable with --executable)',
    },
    args: {
      name: {
        type: 'positional',
        description: 'Filename to generate (default: schematic.config.js, or schematic with --executable)',
        required: false,
        default: '',
      },
      executable: {
        type: 'boolean',
        description: 'Generate a Node executable file instead of a config file (2.x-style setup)',
      },
      ...sharedArgs,
    },
    run: wrapRun(async (app, args) => {
      // `args.name === ''` when user passed no positional — Schematic.init
      // treats falsy filename as "use the mode-specific default."
      await app.init(args.name || undefined, { executable: !!args.executable });
    }),
  });

  const main = defineCommand({
    meta: {
      name: 'schematic',
      version: pkg.version,
      description: 'Write Shopify schema with JS, not JSON',
    },
    args: { ...sharedArgs },
    // No subcommand → default to build behavior. Citty fires BOTH the main
    // `run` AND the matched subcommand's `run` in sequence, so we guard the
    // default-to-build here: only run if no known subcommand appears on argv.
    run: async (ctx) => {
      const firstArg = process.argv[2];
      const hasSubcommand = firstArg && !firstArg.startsWith('-')
        && ['build', 'scaffold', 'section', 'init'].includes(firstArg);
      if (hasSubcommand) return; // Subcommand handler will run separately.
      return buildRun(ctx);
    },
    subCommands: {
      build: buildCommand,
      scaffold: scaffoldCommand,
      section: sectionCommand,
      init: initCommand,
    },
  });

  try {
    await runMain(main);
  } catch (err) {
    // Citty-level errors (invalid args, missing positionals) bubble out here.
    console.error(err.message || String(err));
    process.exit(1);
  }
})();
